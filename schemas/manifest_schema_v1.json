{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CertiPatch MANIFEST.json schema v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}